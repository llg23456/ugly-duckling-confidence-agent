# Android / Gradle build outputs
.gradle/
.gradle-user/
.android-user/
.kotlin/
**/build/
captures/
.externalNativeBuild/
.cxx/
*.hprof

# Local Android SDK and IDE state
# local.properties contains the machine-specific Android SDK path. Android
# Studio creates it automatically; it must not be shared between machines.
local.properties
*.iml
.idea/
.fleet/

# Signing credentials
*.jks
*.keystore
keystore.properties

# Secrets and local environment files (keep templates)
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# Python environments and caches
.venv/
venv/
**/__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.tox/
.nox/
.coverage
htmlcov/
dist/
*.egg-info/

# Local databases, runtime uploads and generated test media
*.db
*.db-journal
*.db-shm
*.db-wal
*.sqlite
*.sqlite-journal
*.sqlite-shm
*.sqlite-wal
*.sqlite3
*.sqlite3-journal
*.sqlite3-shm
*.sqlite3-wal
server/uploads/
server/tmp/
server/tts-test.*

# Packaged apps and logs
*.apk
*.aab
*.log
*.log.*

# Local Codex/chart generation workspaces
/.codex_build/
/.codex_tmp/
/artifacts/cloud-test/
/artifacts/feedback/
/.chart-data-*/
/.codex_widget_check.png
/.widget_page_*.png

# Local presentation, submission and generated documentation artifacts
# Presentation documents now live in ../docs, outside this Git repository.
# Keep these rules to prevent accidentally importing them into the app again.
/docs/
/design_assets/
/output/
/tmp/
/.codex*/
/.drawio-tmp/
/.pptx-edit-tmp/
/今晚实施计划_画像记录与小组件.md
/图标素材替换说明.md
*.ppt
*.pptx
*.pps
*.ppsx
*.doc
*.docx
*.pdf

# OS/editor leftovers
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.tmp
*.bak
*.orig

# Reproducible startup files must stay versioned. These exceptions protect the
# Android and FastAPI entry points if broader ignore rules are added later.
!gradlew
!gradlew.bat
!gradle/libs.versions.toml
!gradle/wrapper/gradle-wrapper.jar
!gradle/wrapper/gradle-wrapper.properties
!server/.env.example
!server/requirements.txt
.local-data/
