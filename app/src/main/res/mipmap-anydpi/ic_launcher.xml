<?xml version="1.0" encoding="utf-8"?>
<!-- A square plate keeps the complete duck silhouette inside the launcher icon. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <size android:width="108dp" android:height="108dp" />
            <solid android:color="#FFF8EB" />
        </shape>
    </item>
    <item
        android:width="62dp"
        android:height="78dp"
        android:gravity="center"
        android:drawable="@drawable/duck_main" />
</layer-list>
